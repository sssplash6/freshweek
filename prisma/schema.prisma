// Prisma schema for freshman.academy weekly goal tracker.
// Prisma 7 uses the new `prisma-client` generator with a required output path.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----- Auth.js (NextAuth) models -----

// The role a person holds IN ONE DEPARTMENT. It lives on the membership, not
// the user, because one person can wear both hats — lead their own department
// while sitting as a plain member of another. Anyone who LEADs at least one
// department (the ops director counts) is expected at the Monday meeting and
// expected to submit weekly/monthly goals — every expectation surface (fines,
// attendance roster, admin flags, reporting stats) keys off that. Everyone
// else can still set and submit goals, but nothing is owed and nothing fined.
enum TeamRole {
  LEAD
  MEMBER
}

// A department of the academy — a first-class row rather than free text, so
// onboarding can offer a fixed list and reporting can group reliably. Its
// lead is whoever holds a LEAD membership in it (usually exactly one).
// Managed by admins on /departments.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  // A mini department (Alumni Council is the first): real for structure,
  // onboarding and reporting, but it runs itself. Leading one carries none of
  // the lead expectations — no Monday meeting seat, no weekly submission
  // deadline — so no fine can ever arise from it (see isExpectedLead in
  // lib/team.ts), and it has no admin-appointed head: the first person to take
  // a seat becomes its lead (see lib/miniDepartments.ts). Someone who ALSO
  // leads a normal department still owes everything through that seat.
  mini Boolean @default(false)

  memberships DepartmentMembership[]

  // Sign-ups who named this department on /pending but aren't approved yet.
  // Not members of it — see User.requestedDepartmentId.
  signupRequests User[] @relation("SignupRequests")
}

// One person's seat in one department, with the hat they wear there. A user
// may hold several (at most one per department), so belonging to Tech and
// leading Sales are two independent rows.
model DepartmentMembership {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  role         TeamRole @default(MEMBER)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Sign-up approval. Company accounts are stamped approved the moment they're
  // created; anyone else waits on /pending until a department lead or an admin
  // lets them in (see lib/approval.ts). Null = still waiting.
  //
  // The department a waiting sign-up says they're joining, asked on /pending
  // BEFORE anyone approves them. It is what makes the queue reviewable: the
  // alert goes to that department's lead (plus tech@) instead of paging every
  // lead in the company about a stranger, and a reviewer can see whose new
  // joiner this is.
  //
  // Deliberately NOT a membership. A membership is what every roster reads —
  // /team, the attendance sheet, eligibleEmployees — so creating one before
  // approval would put a stranger on those lists. Onboarding turns this into
  // the real seat once they're in, arriving prefilled with it.
  requestedDepartmentId String?
  requestedDepartment   Department? @relation("SignupRequests", fields: [requestedDepartmentId], references: [id], onDelete: SetNull)

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("UsersApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  usersApproved User[]   @relation("UsersApproved")

  // Collected during onboarding after the first Google sign-in. These are
  // required before a user reaches the dashboard (see lib/profile.ts).
  // The first department is chosen from the existing Department rows at
  // onboarding (as a MEMBER); admins add further memberships and hand out
  // lead roles on /departments.
  workPhone        String?
  telegramUsername String?
  memberships      DepartmentMembership[]
  birthday         DateTime? // stored at UTC midnight, treated as a calendar day

  // Optional social handles, editable from the profile page. Shown on /team.
  linkedin  String?
  instagram String?

  // Assigned preset animal avatar (emoji). Unique so no two users share one.
  avatar String? @unique

  accounts Account[]
  sessions Session[]
  weeks    Week[]
  months   Month[]

  sharesSent     SubtaskShare[] @relation("SharesFrom")
  sharesReceived SubtaskShare[] @relation("SharesTo")
  goalSharesSent     GoalShare[] @relation("GoalSharesFrom")
  goalSharesReceived GoalShare[] @relation("GoalSharesTo")
  feedback       Feedback[]

  dayTasks         DayTask[]
  dailyReports     DailyReport[]

  penalties        Penalty[] @relation("PenaltiesReceived")
  penaltiesIssued  Penalty[] @relation("PenaltiesIssued")
  penaltiesSettled Penalty[] @relation("PenaltiesSettled")
  finePaymentsRecorded FinePayment[] @relation("FinePaymentsRecorded")
  fineWaivers        FineWaiver[] @relation("FineWaiversReceived")
  fineWaiversGranted FineWaiver[] @relation("FineWaiversIssued")
  bonuses         Bonus[]   @relation("BonusesReceived")
  bonusesIssued   Bonus[]   @relation("BonusesIssued")
  assignedTasks   AssignedTask[] @relation("AssignedReceived")
  tasksAssigned   AssignedTask[] @relation("AssignedIssued")
  attendances     Attendance[]
  notifications   Notification[]

  shootsAssigned      ContentShoot[] @relation("ShootAssigned")
  shootsCreated       ContentShoot[] @relation("ShootsCreated")
  shootReportsFiled   ContentShoot[] @relation("ShootReportsFiled")
  postsCreated        ContentPost[]
  marketingTasksOwned MarketingTask[] @relation("MarketingTasksOwned")
  marketingTasksSet   MarketingTask[] @relation("MarketingTasksSet")
  payrollSubmissions PayrollSubmission[]
  payrollEvents      PayrollEvent[] @relation("PayrollEventsActed")

  reportsFiled    ColleagueReport[] @relation("ReportsFiled")
  reportsClosed   ColleagueReport[] @relation("ReportsClosed")
  reportedIn      ColleagueReportSubject[]

  // The signup queue reads waiting accounts by the department they named.
  @@index([requestedDepartmentId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ----- App models -----

// Goal priority, surfaced as colored flags (green / amber / red). Absent = none.
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Why a penalty was issued. MEETING_SKIPPED fines are driven by meeting
// attendance (escalating); LATE_SUBMISSION is auto-applied to a late week;
// OTHER is a manual admin fine for anything else.
enum PenaltyType {
  MEETING_SKIPPED
  MEETING_LATE
  LATE_SUBMISSION
  LATE_DAILY_REPORT
  OTHER
}

// A fine issued to a user. Amount is a whole number in the app's configured
// currency (see lib/penalties.ts). Optionally linked to the week and/or meeting
// it relates to so it can surface in the right view and be recomputed.
//
// Settlement lifecycle: a fine is "active" (outstanding) while `paidAt` is null.
// Settling is partial-friendly — an admin can record any amount cut from a
// person's salary, and it's applied to their fines oldest-first. `paidAmount`
// tracks how much of this fine that has covered so far:
//
//   paidAmount = 0            → untouched, owes `amount`
//   0 < paidAmount < amount   → part-paid, still active, owes the difference
//   paidAmount = amount       → fully settled; `paidAt`/`settledById` set and
//                               the fine moves to the archive
//
// So outstanding for a user = sum(amount - paidAmount) where paidAt is null,
// and every individual movement of money is recorded as a FinePayment.
model Penalty {
  id         String      @id @default(cuid())
  userId     String
  type       PenaltyType @default(OTHER)
  amount     Int
  note       String?
  weekId     String?
  meetingId  String?
  issuedById String?
  createdAt  DateTime    @default(now())
  // Set when the fine is settled in full (the last of it deducted from salary).
  // Null means still outstanding. `settledBy` is the admin who closed it out.
  paidAt      DateTime?
  settledById String?
  // Money recorded against this fine so far, 0 ≤ paidAmount ≤ amount.
  paidAmount  Int       @default(0)
  // LATE_DAILY_REPORT only: the Tashkent day (UTC-midnight key) the missing
  // report was for. The unique below makes the daily fine sweep idempotent at
  // the database — at most one daily fine per person per day.
  reportDay   DateTime?

  user     User     @relation("PenaltiesReceived", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User?    @relation("PenaltiesIssued", fields: [issuedById], references: [id], onDelete: SetNull)
  settledBy User?   @relation("PenaltiesSettled", fields: [settledById], references: [id], onDelete: SetNull)
  week     Week?    @relation(fields: [weekId], references: [id], onDelete: SetNull)
  meeting  Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  payments FinePayment[]
  payrollLines PayrollFineLine[]

  @@unique([userId, type, reportDay])
  @@index([userId])
  @@index([weekId])
  @@index([meetingId])
}

// One movement of money against one fine — "$50 of this $80 was cut from their
// salary on 6 Aug". Settling a custom amount spreads it over a person's open
// fines oldest-first, so one settlement can write several of these; they share
// a `batchId` and read back as a single receipt. Undoing a receipt deletes its
// rows and gives the fines their balance back, which is why the ledger is kept
// here rather than only as a running total on Penalty.
// Where a fine payment came from: MANUAL is an admin settling on /penalties,
// PAYROLL is the automatic deduction written when a pay request is processed
// (see lib/payroll.ts). Same ledger either way — undoing a batch works for both.
enum FinePaymentSource {
  MANUAL
  PAYROLL
}

model FinePayment {
  id           String   @id @default(cuid())
  penaltyId    String
  amount       Int
  batchId      String
  source       FinePaymentSource @default(MANUAL)
  recordedById String?
  createdAt    DateTime @default(now())

  penalty    Penalty @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("FinePaymentsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([penaltyId])
  @@index([batchId])
}

// A bonus awarded to a user — the positive counterpart of a Penalty, tracked
// separately (no netting against fines). Amount is a whole number in the app's
// configured currency (see lib/penalties.ts formatMoney).
model Bonus {
  id         String   @id @default(cuid())
  userId     String
  amount     Int
  note       String?
  issuedById String?
  createdAt  DateTime @default(now())
  // Set when a PROCESSED pay request paid this bonus out. A consumed bonus can
  // never enter another payroll snapshot and can't be deleted — it's money
  // that already moved (mirrors the part-paid rule on Penalty).
  payrollSubmissionId String?

  user      User  @relation("BonusesReceived", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy  User? @relation("BonusesIssued", fields: [issuedById], references: [id], onDelete: SetNull)
  paidOutBy PayrollSubmission? @relation("BonusesPaidOut", fields: [payrollSubmissionId], references: [id], onDelete: SetNull)
  payrollLines PayrollBonusLine[]

  @@index([userId])
}

// Whether an assigned goal is a weekly or a monthly one — controls which
// dashboard view (week/month) surfaces it to the assignee.
enum AssignScope {
  WEEKLY
  MONTHLY
}

// A goal an admin assigns to a specific person. Lives outside the weekly/monthly
// goal flow — it's a standalone task the assignee tracks and marks done, and it
// does NOT count toward their week completion percent.
model AssignedTask {
  id           String    @id @default(cuid())
  userId       String
  assignedById String?
  title        String
  note         String?
  scope        AssignScope @default(WEEKLY)
  deadline     DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  user       User  @relation("AssignedReceived", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedIssued", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

// What a notification is about — drives its color/icon in the updates feed.
enum NotificationType {
  FINE
  BONUS
  TASK_ASSIGNED
  REPORT
  PAYROLL
  MARKETING
  OTHER
}

// An in-app notification addressed to one user. Written alongside fines,
// bonuses, task assignments, and colleague reports (see lib/notifications.ts),
// and surfaced in the dashboard's "Last 48 hours" updates zone. `readAt` is
// set when the user marks their notifications read — it drives the bell badge.
// One person's daily report — a short note on the day, due by that day's
// midnight (Tashkent). Weekdays are expected, weekends optional; who reports
// and how a day's status is derived lives in lib/dailyReports.ts. The content
// stays editable after sending: `submittedAt` keeps the FIRST send (on-time is
// judged against it, mirroring Week.submittedAt), `lastSentAt` the most recent
// send, and each resend re-notifies the recipient.
model DailyReport {
  id     String @id @default(cuid())
  userId String
  // The Tashkent calendar day the report is for, at UTC midnight — the same
  // date-only convention as goal deadlines.
  day         DateTime
  content     String
  submittedAt DateTime @default(now())
  lastSentAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

// The lazy no-cron claim for the 21:00 (Tashkent) daily-report nudge: one row
// per day, created by whichever page load reaches the slot first (the same
// optimistic-claim pattern as PayrollPeriod.reminderSentAt).
model DailyReportReminder {
  day    DateTime @id
  sentAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(OTHER)
  message   String
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A recurring team meeting (Monday 10:00 company time — 11:00 for weeks
// before lib/meetings.ts's MEETING_10AM_FROM_MONDAY, which is why a row stores
// the instant it was held at rather than deriving it). One row per time slot.
model Meeting {
  id          String   @id @default(cuid())
  scheduledAt DateTime @unique
  createdAt   DateTime @default(now())

  attendances Attendance[]
  penalties   Penalty[]
  fineWaivers FineWaiver[]
}

// Whether a person attended a meeting. There's no automatic arrival detection —
// an admin (Shakhzod) marks each person. EXCUSED = no fine and resets the
// consecutive-skip streak. LATE = flat fine but counts as present, so it also
// resets the streak.
enum AttendanceStatus {
  ATTENDED
  LATE
  SKIPPED
  EXCUSED
}

model Attendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

// A fine an admin deliberately cancelled, for the two kinds the app derives
// rather than stores: late submissions (recomputed from whether the week was
// reported on time) and meeting attendance (recomputed from the attendance
// history). Deleting those Penalty rows alone never held — the next reconcile
// re-derived them from the source and raised the fine again — so a waiver
// records the decision the source can't.
//
// Exactly one of the two keys is set: `cycleDeadline` is the Sunday-12:00
// instant identifying a submission cycle (see lib/lateness weekSubmissionDeadline),
// `meetingId` names a meeting. Manual (OTHER) fines need none of this: nothing
// re-derives them, so deleting one is already final.
model FineWaiver {
  id            String    @id @default(cuid())
  userId        String
  cycleDeadline DateTime?
  meetingId     String?
  waivedById    String?
  createdAt     DateTime  @default(now())

  user     User     @relation("FineWaiversReceived", fields: [userId], references: [id], onDelete: Cascade)
  waivedBy User?    @relation("FineWaiversIssued", fields: [waivedById], references: [id], onDelete: SetNull)
  meeting  Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // One waiver per person per cycle, and per person per meeting. Postgres treats
  // NULLs as distinct, so the unused key never collides across rows.
  @@unique([userId, cycleDeadline])
  @@unique([userId, meetingId])
  @@index([userId])
}

model Week {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(true)
  // True when the week was started (previous week closed + new goals submitted)
  // after the Sunday 12:00 Tashkent deadline. Set when a week is explicitly
  // started; auto-created first weeks stay false. See lib/lateness.ts.
  submittedLate Boolean @default(false)
  // The *first* time the user submitted their goals for this week. Set once and
  // never overwritten or cleared — re-submitting after an edit keeps the
  // original time. Null until the first submit. Surfaced to admins.
  submittedAt DateTime?
  // Whether the goal list is currently locked (submitted state). Submitting sets
  // this true; "Edit goals" sets it false without touching submittedAt.
  goalsLocked Boolean @default(false)
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals     Goal[]
  penalties Penalty[]

  @@index([userId])
  @@index([userId, isCurrent])
}

// The monthly counterpart of Week. Same submit/lock/close lifecycle, but with
// no submission deadline (so no lateness flag or penalties). Months are always
// whole calendar months.
model Month {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(true)
  // First goal submission for this month — set once, never overwritten (same
  // semantics as Week.submittedAt).
  submittedAt DateTime?
  goalsLocked Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]

  @@index([userId])
  @@index([userId, isCurrent])
}

model Goal {
  id               String   @id @default(cuid())
  // A goal belongs to exactly one period: either a week or a month.
  weekId           String?
  monthId          String?
  title            String
  position         Int
  // Reflection captured when closing a week if this goal wasn't marked complete.
  incompleteReason String?
  // Set when the user explicitly marks the goal done. Finishing every subtask
  // does NOT complete a goal on its own — completion is always a deliberate act.
  completedAt      DateTime?
  // Optional due date (stored at UTC midnight; the app treats it as date-only).
  deadline         DateTime?
  // Optional priority flag (none when null).
  priority         Priority?
  // Manual progress override (0–100) typed by the user in place of the
  // subtask-derived percent. Cleared whenever a subtask is toggled so the
  // derived value takes back over. A completed goal always reads 100.
  manualPercent    Int?
  createdAt        DateTime  @default(now())

  week     Week?     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  month    Month?    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  subtasks Subtask[]

  // Delegation: a goal may be the original of several shares (shared out)
  // and/or the copy created by a single incoming share (received). Mirrors
  // the subtask fields of the same names.
  sharesOut GoalShare[] @relation("GoalShareOriginal")
  shareIn   GoalShare?  @relation("GoalShareCopy")

  @@index([weekId])
  @@index([monthId])
}

model Subtask {
  id        String   @id @default(cuid())
  goalId    String
  title     String
  isDone    Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // Delegation: a subtask may be the original of several shares (shared out)
  // and/or the copy created by a single incoming share (received).
  sharesOut SubtaskShare[] @relation("ShareOriginal")
  shareIn   SubtaskShare?  @relation("ShareCopy")

  @@index([goalId])
}

// A single day's focus task — "today I'm attending to the tech department".
// Deliberately standalone: a DayTask is NOT a Goal. It belongs to no week or
// month, carries no priority flag or subtasks, and never counts toward a week /
// month completion percent. It exists only to answer "what am I doing today?".
//
// `position` IS the priority: 1 is the day's main focus, 2 the second, and so
// on. The list is reordered by hand, so there's no separate priority field.
// `date` is stored at UTC midnight and read as a plain calendar day, matching
// Goal.deadline and User.birthday (see lib/dates.ts).
model DayTask {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  title     String
  position  Int
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// A delegation of a subtask from one user to another. The original stays on the
// sender's list (marked "shared to X"); a linked copy is added to the recipient.
model SubtaskShare {
  id                String   @id @default(cuid())
  originalSubtaskId String
  copySubtaskId     String   @unique
  fromUserId        String
  toUserId          String
  createdAt         DateTime @default(now())

  originalSubtask Subtask @relation("ShareOriginal", fields: [originalSubtaskId], references: [id], onDelete: Cascade)
  copySubtask     Subtask @relation("ShareCopy", fields: [copySubtaskId], references: [id], onDelete: Cascade)
  fromUser        User    @relation("SharesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser          User    @relation("SharesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([originalSubtaskId, toUserId])
  @@index([originalSubtaskId])
}

// A delegation of a whole goal (with or without subtasks) from one user to
// another. Same shape as SubtaskShare: the original stays on the sender's list
// (marked "shared to X"); a linked copy — goal plus fresh unchecked subtasks —
// is added to the recipient's current period.
model GoalShare {
  id             String   @id @default(cuid())
  originalGoalId String
  copyGoalId     String   @unique
  fromUserId     String
  toUserId       String
  createdAt      DateTime @default(now())

  originalGoal Goal @relation("GoalShareOriginal", fields: [originalGoalId], references: [id], onDelete: Cascade)
  copyGoal     Goal @relation("GoalShareCopy", fields: [copyGoalId], references: [id], onDelete: Cascade)
  fromUser     User @relation("GoalSharesFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User @relation("GoalSharesTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([originalGoalId, toUserId])
  @@index([originalGoalId])
}

// ----- Marketing content plan -----

// One planned piece of video content: what it is, when it shoots, where, and
// who the assigned creator is. Shoot state is DERIVED, never stored —
// `reportedAt` null and `shootAt` in the future is upcoming, in the past is
// "awaiting report", and `reportedAt` set is reported. `shootAt` is a real
// instant (the Meeting.scheduledAt convention) displayed in Tashkent.
//
// The videographer's report is two Google Drive links — the finished cut and
// the raw materials. Links only: nothing is uploaded here, and either link
// may be left for later, which is why both are nullable rather than a pair.
//
// `reminderSentAt` is the shoot-reminder sweep's claim (the lazy no-cron
// pattern of PayrollPeriod.reminderSentAt): whichever page load reaches an
// assigned shoot inside its reminder window first writes it, so racing loads
// can't send the nudge twice.
//
// The plan belongs to the department, not the person: every actor link is
// SetNull so a seat leaving marketing doesn't erase the calendar they built.
model ContentShoot {
  id        String   @id @default(cuid())
  title     String
  shootAt   DateTime
  location  String
  assigneeId String?
  note      String?

  reminderSentAt DateTime?
  finishedUrl    String?
  rawUrl         String?
  reportedAt     DateTime?
  reportedById   String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee   User? @relation("ShootAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  reportedBy User? @relation("ShootReportsFiled", fields: [reportedById], references: [id], onDelete: SetNull)
  createdBy  User? @relation("ShootsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  posts      ContentPost[]

  @@index([shootAt])
  @@index([assigneeId])
}

// One scheduled publication on the posting calendar. `shootId` is optional —
// plenty of posts (a graphic, a repost, an announcement) were never a shoot —
// and SetNull so calling the shoot off doesn't take the post down with it.
// `publishAt` is a real instant rendered in Tashkent, like `shootAt`.
//
// `platforms` is the channels it goes out on — one row per piece of content,
// not per channel, because cross-posting the same cut is the norm. Values are
// the POST_PLATFORMS keys in lib/marketing.ts (validated there, not an enum,
// so adding a channel is a code change rather than a migration). `caption` is
// the copy/brief for whoever publishes; `postUrl` is the live link, filled in
// once it's out.
model ContentPost {
  id          String   @id @default(cuid())
  title       String
  publishAt   DateTime
  platforms   String[] @default([])
  caption     String?
  postUrl     String?
  shootId     String?
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shoot     ContentShoot? @relation(fields: [shootId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([publishAt])
}

// Work one marketing teammate hands another — the same idea as AssignedTask
// but peer-to-peer inside the department rather than top-down from an admin,
// and tracked with an honest percent like a goal's manualPercent. Lives on
// /marketing, out of the weekly goal flow, so it never counts toward a week's
// completion percent. `dueOn` is a date-only (UTC midnight, the goal-deadline
// convention); `completedAt` is the deliberate done-mark, reopened by nulling.
model MarketingTask {
  id          String   @id @default(cuid())
  title       String
  note        String?
  dueOn       DateTime?
  assigneeId  String
  percent     Int      @default(0)
  completedAt DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee  User  @relation("MarketingTasksOwned", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("MarketingTasksSet", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([dueOn])
}

// A member reporting another member — the "Report a colleague" form on
// /penalties. It began life as a notification to the admins and nothing else,
// which meant a report was unfindable 48 hours later and nobody could say what
// had been done about it. The row IS the record; the notification stays as the
// ping.
//
// The reason is one text field because that is what the form asks for. Who it
// names is a join table, not a string, so "what has been reported about this
// person" is a query rather than a search through prose.
enum ColleagueReportStatus {
  OPEN
  ACTIONED // an admin acted on it (usually a fine)
  DISMISSED // looked at, nothing to do
}

model ColleagueReport {
  id         String   @id @default(cuid())
  reporterId String?
  reason     String
  createdAt  DateTime @default(now())

  status     ColleagueReportStatus @default(OPEN)
  // Who closed it and when. `resolution` is the optional note an admin leaves
  // — what was done, or why nothing was — so a closed report explains itself
  // months later.
  closedById String?
  closedAt   DateTime?
  resolution String?

  // Backfilled rows only (scripts/backfill-colleague-reports.ts). Reports filed
  // before this table existed survive as the admin notification's text, where
  // people are NAMED rather than linked. The backfill resolves those names to
  // accounts where it can; whoever it can't (renamed, deleted) is kept here
  // verbatim instead of being dropped, so the record still says who filed it
  // and who it was about.
  legacyReporter String?
  legacySubjects String?

  // SetNull on both, like every other actor link here: a report survives the
  // account that filed or closed it, because it is a record of what happened.
  reporter User? @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  closedBy User? @relation("ReportsClosed", fields: [closedById], references: [id], onDelete: SetNull)
  subjects ColleagueReportSubject[]

  @@index([status, createdAt])
  @@index([reporterId])
}

// One person named in one report. Cascades with the report; if the named
// account is deleted the row goes with it (there is nothing left to be about).
model ColleagueReportSubject {
  reportId String
  userId   String

  report ColleagueReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@index([userId])
}

// Product feedback addressed to tech@freshman.academy. Stored here rather than
// emailed (no mail provider configured); read straight from the table. The
// submitter's email is captured at write time so it survives user deletion.
model Feedback {
  id        String   @id @default(cuid())
  message   String
  userId    String?
  userEmail String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ----- Payroll -----

// Lifecycle of a monthly pay request:
//
//   DRAFT → WITH_LEAD → SUBMITTED → PROCESSED
//              │  ↑         │
//              │  └─────────┘  (filer edits, or finance sends it back:
//              │                 a changed request needs approving again)
//              └──▶ DECLINED → WITH_LEAD*  ─▶ EXPIRED (resubmit window lapsed)
//
// WITH_LEAD is the department lead's desk: they see what their own person is
// claiming and either pass it on or send it back. SUBMITTED then sits in the
// reviewer's queue (finance), who decline it back to the filer or pay it —
// and CANNOT pay a request that has not come through the lead, which is what
// makes the middle step a gate rather than a notification (lib/payroll.ts
// TRANSITIONS, and ACTIONABLE in app/payroll/finance/actions.ts).
//
// A filer with no lead to answer to — a lead themselves, or seats only in a
// mini department, which runs itself — files straight to SUBMITTED, with the
// skip recorded in the audit log (lib/payrollApproval.ts).
//
// APPROVED_BY_ADMIN is legacy: nothing enters it since the admin stage it
// belonged to was removed, but rows and audit events still hold it and such a
// row is still unpaid money, so it queues beside SUBMITTED and takes the same
// two exits. The value stays in the enum for those rows. PROCESSED and EXPIRED
// are terminal — an expired filing simply rolls into the next month's cycle
// (its snapshot there sweeps up whatever is still unpaid). Guards and side
// effects live in lib/payroll.ts; the UI never sets a status directly.
enum PayrollStatus {
  DRAFT
  WITH_LEAD
  SUBMITTED
  DECLINED
  EXPIRED
  APPROVED_BY_ADMIN
  PROCESSED
}

// How the person wants to be paid. UZCARD carries card number + holder name in
// paymentDetails, WISE the account email, CASH nothing.
// How someone is paid. These mirror the "Source" column of the finance team's
// accounting sheet one-for-one, so a filed payroll row can be reconciled
// against it without translation. Labels live in lib/payrollTypes.ts.
// The "Source" column of the finance team's accounting sheet. Payroll settles
// through four of these now — CASH_UZBEKISTAN, PAYME, UZBEK_COMPANY and
// WISE_USD (which finance simply calls Wise) — and the rest are RETIRED: no
// new filing can name one, but rows already filed under them keep it, because
// a paid request has to keep saying how it was actually paid. The offered list
// lives in lib/payrollTypes.ts (PAYROLL_METHODS_OFFERED), which is also what
// the filing form and the submit action check against; this enum is only the
// set of values the column may hold.
enum PayrollMethod {
  CASH_SINGAPORE
  CASH_UZBEKISTAN
  PAYME
  UZBEK_COMPANY
  WISE_USD
  BANK_TRANSFER
  UZS_CARD
  VISA_CARD
  STRIPE
  SG_CASH
  SG_BANK
  KAPITAL_BANK
  VARIOUS
}

// One calendar month of payroll, boundaries in Asia/Tashkent (stored as UTC
// instants). The filing window is DATA (`filingOpensAt` … `filingClosesAt`),
// not arithmetic repeated at call sites: it opens 00:00:00 on the third-last
// day of the month and closes 23:59:59 on the FIRST day of the next one — four
// days, so everyone files against a nearly-final ledger and finance reviews one
// batch. Because it crosses the month boundary, the 1st of a month still
// belongs to the month before it (see periodBoundsFor in lib/payroll.ts).
// `remindAt` is 09:00 on the opening day, inside the window; `reminderSentAt`
// is the lazy reminder sweep's once-per-period claim (same no-cron pattern as
// lib/submissionFines.ts). Rows exist only from the feature's launch month
// onward, created on demand — each keeps the window it was created with.
model PayrollPeriod {
  id             String    @id @default(cuid())
  year           Int
  month          Int // 1–12
  startsAt       DateTime
  endsAt         DateTime
  filingOpensAt  DateTime
  filingClosesAt DateTime
  remindAt       DateTime
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  submissions PayrollSubmission[]

  @@unique([year, month])
}

// One person's pay request for one period. Bonus and fine amounts are a
// SNAPSHOT taken at (re)submit time — never read live — so an approved invoice
// can't change because the ledger moved later; the line tables below keep the
// per-source breakdown auditable. Money is whole-dollar USD (the app-wide
// convention, see lib/penalties.ts) EXCEPT self-reported expenses, which people
// pay in real prices ($1.95 for a tool) and so carry cents — units in the name,
// as with amountSgdCents below.
//
// netTotal is what actually gets paid: baseSalary + bonusesTotal − finesTotal +
// expenses, rounded half-up to whole dollars ONCE at the end (computeNet in
// lib/payrollTypes.ts). Rounding each expense instead would quietly re-price
// every line; rounding the sum moves the payout by at most 50¢.
//
// At most one NON-terminal submission per person across all periods (enforced
// in lib/payroll.ts): filing next month while last month's request is still in
// flight would double-count the bonuses and fines both snapshots saw.
model PayrollSubmission {
  id       String        @id @default(cuid())
  userId   String
  periodId String
  status   PayrollStatus @default(DRAFT)

  baseSalary         Int
  bonusesTotal       Int @default(0)
  finesTotal         Int @default(0)
  expensesTotalCents Int @default(0)
  netTotal           Int

  paymentMethod  PayrollMethod
  paymentDetails Json          @default("{}")

  // The payout figures, filled in by finance on /payroll/sheet as they settle
  // each request. They mirror the accounting sheet's own columns, which is
  // where these numbers live today: the app knows the USD arithmetic
  // (salary/bonus/penalty/net) but not what actually left which account.
  //
  // UNITS ARE IN THE NAMES on purpose. UZS has no subunit in practice so it's
  // whole som, but SGD and the Wise fee carry cents in the sheet ($50.00), and
  // the rest of this app is whole-dollar Int — a bare `amountSgd` would be
  // read as dollars by the next person and be wrong by 100x.
  // Null means "not settled/recorded yet", which is not the same as zero.
  amountUzs      Int?
  amountSgdCents Int?
  wiseFeeCents   Int?

  // First submit, never overwritten (the Week.submittedAt convention);
  // lastSubmittedAt moves with every resubmit and is the snapshot instant.
  submittedAt     DateTime?
  lastSubmittedAt DateTime?

  // Set on decline: the period's filing cutoff, plus 24h ONLY when the decline
  // lands on the window's last day (see resubmitWindowFor in lib/payroll.ts).
  // A decline never shortens the deadline the filer already had — being turned
  // back on the 27th leaves the normal cutoff in place. The past-cutoff day is
  // granted once per period (`graceDayUsed`), and the rule is two-valued and
  // monotone in time, so a re-decline can never extend the window further.
  resubmitDeadline DateTime?
  graceDayUsed     Boolean   @default(false)

  // Written at PROCESSED: the FinePayment batch of the fine deduction (one
  // receipt on /penalties, undoable there like any settlement).
  fineBatchId String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  bonusLines     PayrollBonusLine[]
  fineLines      PayrollFineLine[]
  expenses       PayrollExpense[]
  events         PayrollEvent[]
  pdf            PayrollPdf?
  bonusesPaidOut Bonus[]            @relation("BonusesPaidOut")

  @@unique([userId, periodId])
  @@index([periodId, status])
  @@index([userId, status])
}

// Snapshot of one bonus at submit time. `amount`/`note`/`awardedAt` are copies,
// so the invoice breakdown survives the source row being edited or deleted
// later (bonusId then goes null, the line stays).
model PayrollBonusLine {
  id           String   @id @default(cuid())
  submissionId String
  bonusId      String?
  amount       Int
  note         String?
  awardedAt    DateTime

  submission PayrollSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  bonus      Bonus?            @relation(fields: [bonusId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

// Snapshot of one fine at submit time. `amount` is the OUTSTANDING balance then
// (amount − paidAmount — partial payments already exist), not the face value.
// On PROCESSED exactly this amount is written back against exactly this fine.
model PayrollFineLine {
  id           String      @id @default(cuid())
  submissionId String
  penaltyId    String?
  amount       Int
  type         PenaltyType
  note         String?
  issuedAt     DateTime

  submission PayrollSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  penalty    Penalty?          @relation(fields: [penaltyId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

// A self-reported miscellaneous expense line on a submission, with an optional
// uploaded receipt (bytes live in PayrollReceipt so lists never drag blobs).
model PayrollExpense {
  id           String @id @default(cuid())
  submissionId String
  label        String
  // Cents, not dollars — a real receipt is $1.95, and rounding it here would
  // change what the line says it was for. The rounding happens once, on the
  // submission's netTotal.
  amountCents  Int
  position     Int

  submission PayrollSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  receipt    PayrollReceipt?

  @@index([submissionId])
}

// Receipt file for one expense, stored in Postgres — Render's filesystem is
// ephemeral, so bytes never touch disk. Size/type are capped at upload
// (lib/payrollTypes.ts). Fetched only by the download route, never in lists.
model PayrollReceipt {
  id        String   @id @default(cuid())
  expenseId String   @unique
  filename  String
  mimeType  String
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())

  expense PayrollExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// The generated invoice PDF for a submission's CURRENT snapshot — regenerated
// (replaced) on every resubmission. Kept out of PayrollSubmission for the same
// reason receipts have their own table: Prisma selects all scalars by default,
// and queue queries must not haul PDF bytes.
model PayrollPdf {
  id           String   @id @default(cuid())
  submissionId String   @unique
  bytes        Bytes
  updatedAt    DateTime @updatedAt

  submission PayrollSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// Append-only audit log: one row per status transition, written in the same
// transaction as the transition itself. Decline and send-back notes live here.
// Nothing anywhere updates or deletes a row (a null actor is the system, e.g.
// the lazy expiry sweep).
model PayrollEvent {
  id           String         @id @default(cuid())
  submissionId String
  actorId      String?
  fromStatus   PayrollStatus?
  toStatus     PayrollStatus
  note         String?
  createdAt    DateTime       @default(now())

  submission PayrollSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User?             @relation("PayrollEventsActed", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}
